# Salin ke .env lalu isi. JANGAN commit .env.
APP_ENV=dev
LOG_LEVEL=INFO

DB_HOST=db
DB_PORT=5432
DB_NAME=soc16ti
DB_USER=soc16ti
# Password DB dibaca dari file (docker secret), bukan dari env.
DB_PASSWORD_FILE=/run/secrets/db_password

JWT_SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRE_MINUTES=30

MISP_MODE=mock

# Sumber reputasi IP (AbuseIPDB + VirusTotal). Satu saklar untuk kedua sumber.
# mock = data simulasi (berflag SUMBER_SIMULASI), tidak ada request keluar.
# live = request ke AbuseIPDB dan VirusTotal asli (memakan kuota akun tim); butuh kedua file key valid.
SOURCES_MODE=mock
# API key dibaca dari file (docker secret), bukan dari env; JANGAN taruh key di sini.
# File sumbernya (secrets/*.txt) harus ada walau mode mock; boleh kosong. Lihat README.
ABUSEIPDB_API_KEY_FILE=/run/secrets/abuseipdb_api_key
VIRUSTOTAL_API_KEY_FILE=/run/secrets/virustotal_api_key
SOURCE_TIMEOUT_SECONDS=10
ABUSEIPDB_MAX_AGE_DAYS=30
# Kuota akun tim, dipakai bersama semua user.
ABUSEIPDB_DAILY_LIMIT=1000
VT_DAILY_LIMIT=500
VT_PER_MINUTE_LIMIT=4
# TTL cache: nilai percobaan, belum disepakati tim.
CACHE_TTL_OK_SIGNAL_HOURS=6
CACHE_TTL_OK_NO_SIGNAL_HOURS=24
CACHE_TTL_NO_RECORD_HOURS=1

# Akun awal untuk `python -m scripts.seed_users`. Password minimal 12 karakter.
# Nilai contoh (berawalan `ganti-`) di bawah dan di JWT_SECRET_KEY WAJIB diganti: aplikasi
# menolak start, dan seed menolak berjalan, jika nilai itu masih dipakai.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=ganti-saya-min-12-karakter
SEED_ANALYST_MISP_USER=analyst_misp
SEED_ANALYST_MISP_PASSWORD=ganti-saya-min-12-karakter
SEED_ANALYST_USER=analyst
SEED_ANALYST_PASSWORD=ganti-saya-min-12-karakter
SEED_VIEWER_USER=viewer
SEED_VIEWER_PASSWORD=ganti-saya-min-12-karakter
