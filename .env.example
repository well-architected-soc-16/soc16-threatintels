# Salin ke .env lalu isi. JANGAN commit .env.
APP_ENV=dev
LOG_LEVEL=INFO

DB_HOST=db
DB_PORT=5432
DB_NAME=soc16ti
DB_USER=soc16ti
# Password DB dibaca dari file (docker secret), bukan dari env.
DB_PASSWORD_FILE=/run/secrets/db_password

JWT_SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRE_MINUTES=30

MISP_MODE=mock

# Dipakai di Tahap 1 (seed user). Password minimal 12 karakter.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=ganti-saya-min-12-karakter
SEED_ANALYST_MISP_USER=analyst_misp
SEED_ANALYST_MISP_PASSWORD=ganti-saya-min-12-karakter
SEED_ANALYST_USER=analyst
SEED_ANALYST_PASSWORD=ganti-saya-min-12-karakter
SEED_VIEWER_USER=viewer
SEED_VIEWER_PASSWORD=ganti-saya-min-12-karakter
